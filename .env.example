# ---- Server (server.ts) ----
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Used only to create the first super admin when none exists in the database.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# DEV ONLY: when set, also seeds owner/dispatch/analysis/customer test users with this password.
SEED_TEST_PASSWORD=
GEMINI_API_KEY=
APP_URL="http://localhost:3000"

# ---- Frontend (exposed to the browser - never put secrets here) ----
# Phone number (E.164, e.g. +91XXXXXXXXXX) allowed into the admin panel.
VITE_ADMIN_PHONE=
# DEV ONLY: fake OTP login for testing. Leave empty in production.
VITE_TEST_LOGIN_OTP=
VITE_TEST_CUSTOMER_PHONE=
VITE_TEST_ADMIN_PHONE=
VITE_GOOGLE_SHEETS_WEBHOOK_URL=
