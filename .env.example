# Nothing is required to build the website — public settings live in
# src/firebase.ts and src/config/site.ts.
#
# Optional, for local testing only (copy to .env.local):

# Point the site at local Firebase emulators instead of the real project.
# VITE_USE_EMULATOR=true

# Temporarily override tracking IDs (normally edit src/config/site.ts).
# VITE_GA4_ID=
# VITE_META_PIXEL_ID=
# VITE_SENTRY_DSN=
