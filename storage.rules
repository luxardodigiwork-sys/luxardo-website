rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin' ||
        request.auth.uid == '0Frc6Dy2MqN0zc0UFkmqvpELFnr1'
      );
    }

    function isAllowedImage(maxBytes) {
      return request.resource != null
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size <= maxBytes;
    }

    // Customer uploads: registered (non-anonymous) users, own folder only.
    match /user-uploads/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && isAllowedImage(5 * 1024 * 1024);
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Everything else: public read (storefront images), admin-only write,
    // images only, 50 MB max (matches the admin uploader limit).
    match /{allPaths=**} {
      // Customer uploads (user-uploads/...) are private: owner or admin only.
      allow read: if !resource.name.matches('user-uploads/.*');
      allow create, update: if isAdmin() && isAllowedImage(50 * 1024 * 1024);
      allow delete: if isAdmin();
    }
  }
}
