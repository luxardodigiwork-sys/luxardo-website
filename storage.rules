rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true ||
        request.auth.uid == 'jOnrDrh2EYghgU3ebCkWr694aDt1' ||
        request.auth.uid == 'PqH3UUjP1acXGxyBNu2kOMTr0Xw1'
      );
    }

    function isAllowedImage(maxBytes) {
      return request.resource != null
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size <= maxBytes;
    }

    // Customer uploads: registered (non-anonymous) users, own folder only.
    match /user-uploads/{userId}/{allPaths=**} {
      // Reads fall under the public-read rule below (storefront-style download URLs).
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && isAllowedImage(5 * 1024 * 1024);
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Everything else: public read (storefront images), admin-only write,
    // images only, 50 MB max (matches the admin uploader limit).
    match /{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isAllowedImage(50 * 1024 * 1024);
      allow delete: if isAdmin();
    }
  }
}
