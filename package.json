{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --config firebase.rules-test.json --only firestore,storage --project rules-test \"node --test tests/rules.test.mjs\"",
    "test:unit": "node --import tsx --test tests/core.test.ts tests/client.test.ts tests/errorReporter.test.ts",
    "test:orders": "firebase emulators:exec --config firebase.rules-test.json --only firestore --project orders-test \"node --import tsx --test tests/orders.test.ts\"",
    "test": "npm run test:unit && npm run test:rules && npm run test:orders"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.4.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "country-to-currency": "^2.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.10.0",
    "framer-motion": "^11.0.0",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.18",
    "lucide-react": "^0.546.0",
    "motion": "^12.35.2",
    "razorpay": "^2.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-joyride": "^3.0.2",
    "react-markdown": "^10.1.0",
    "react-phone-input-2": "^2.15.1",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "firebase-tools": "^15.33.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
