rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -------------------------------------------------------
    // Admin = hardcoded owner UIDs (legacy) OR Firebase custom claim admin=true.
    // The claim must be set server-side (Admin SDK); clients cannot forge it.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true ||
        request.auth.uid == 'jOnrDrh2EYghgU3ebCkWr694aDt1' ||
        request.auth.uid == 'PqH3UUjP1acXGxyBNu2kOMTr0Xw1'
      );
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Real (phone/email) account, not an anonymous guest session.
    function isRegisteredUser() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Fields a customer must never be able to set or change on their own profile.
    function privilegedKeys() {
      return ['role', 'isAdmin', 'admin', 'permissions', 'isPrimeMember',
              'primePrivileges', 'membershipActivation', 'membershipExpiry',
              'forcePasswordReset', 'notes'];
    }

    // Create: no privileged fields, except role may be exactly 'customer'
    // and isPrimeMember may be exactly false (what the signup flow writes).
    function safeProfileCreate() {
      let d = request.resource.data;
      return d.keys().hasAny(['isAdmin', 'admin', 'permissions', 'primePrivileges',
                              'membershipActivation', 'membershipExpiry',
                              'forcePasswordReset', 'notes']) == false &&
        (!('role' in d) || d.role == 'customer') &&
        (!('isPrimeMember' in d) || d.isPrimeMember == false);
    }

    // Update: privileged fields must be untouched.
    function safeProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(privilegedKeys()) == false;
    }

    // ---- Catalogue (public read, admin write) --------------------------
    // Basic integrity for catalogue writes: price/stock must be sane numbers.
    function validProduct() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0
        && d.price is number && d.price >= 0
        && (!('stock' in d) || (d.stock is int && d.stock >= 0));
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && validProduct();
      allow delete: if isAdmin();
    }

    // ---- Admin-only probe doc used by the client to learn if the signed-in
    // user is an admin (read is allowed only for admins; doc need not exist).
    match /adminCheck/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- Customer profiles ---------------------------------------------
    match /customers/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && safeProfileCreate();
      allow update: if isOwner(userId) && safeProfileUpdate();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && safeProfileCreate();
      allow update: if isOwner(userId) && safeProfileUpdate();
      allow create, update, delete: if isAdmin();
    }

    // ---- Orders ----------------------------------------------------------
    // Orders are created, priced, paid and stock-adjusted ONLY by the payment backend
    // (Cloud Functions / Admin SDK, which bypass these rules). Clients can never create an order,
    // so nobody can fabricate a paid order or alter totals.
    // Customers can read their own orders. Admins can read all orders and may update FULFILMENT
    // fields only: never money, payment, items or stock fields. An unpaid order cannot be moved
    // forward, and cancellation must go through the cancelOrderFn callable (it restores stock once).
    function adminOrderFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'verificationStatus', 'trackingId', 'trackingUrl', 'courierName', 'courierService',
        'courierStatus', 'dispatchDate', 'dispatchNote', 'assignedStaffId', 'assignedStaffName',
        'internalRemarks', 'statusHistory', 'updatedAt']);
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow delete: if false;
      allow read: if isAdmin();
      allow update: if isAdmin() && adminOrderFieldsOnly()
        && (request.resource.data.status == resource.data.status
            || (resource.data.paymentStatus == 'paid'
                && request.resource.data.status in ['processing', 'packed', 'shipped', 'delivered', 'returned', 'failed_delivery']));
    }

    // ---- Per-user data -----------------------------------------------------
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /wishlists/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /userPreferences/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Anonymous country/currency preference. Readable only by document id
    // (no listing), writable only with the expected keys.
    match /sessions/{sessionId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if request.resource.data.keys()
        .hasOnly(['country', 'currency', 'language', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // Wishlist items: doc id is "<uid>_<productId>", owner only.
    match /favorites/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && docId.matches(request.auth.uid + '_.*');
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // "Notify me about low stock" subscriptions, doc id "<uid>_<productId>".
    match /lowStockNotifications/{docId} {
      allow create: if isRegisteredUser()
        && request.resource.data.userId == request.auth.uid
        && docId.matches(request.auth.uid + '_.*');
      allow read, delete: if isRegisteredUser() && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
